---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import FacetChips from "../../components/FacetChips.astro";
import { displayName } from "../../lib/wikilinks";
import { capitalize } from "../../lib/archive";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const images = await getCollection("images");
  return images
    .filter((i) => i.data.publish)
    .map((img) => ({ params: { slug: img.id }, props: { img } }));
}

const { img } = Astro.props;
const { Content } = await render(img);

// Show a ≤2400px WebP on the page (assets/display/), link to the untouched original.
const file = img.data.image_file;
const base = file.replace(/\.[^.]+$/, "");
const hasDisplay = !!file && fs.existsSync(path.join("assets", "display", `${base}.webp`));
const displaySrc = hasDisplay ? `/assets/display/${base}.webp` : `/assets/${file}`;
const originalPath = path.join("assets", file);
const originalMB = file && fs.existsSync(originalPath) ? fs.statSync(originalPath).size / 1e6 : 0;
const originalSize = originalMB >= 1 ? `${originalMB.toFixed(1)} MB` : `${Math.max(1, Math.round(originalMB * 1000))} KB`;
---

<Base title={img.data.title}>
  <article class="image-page" data-pagefind-body>
    <meta data-pagefind-filter="Section[content]" content="Images" />
    {img.data.subtype && <meta data-pagefind-filter="Image type[content]" content={capitalize(img.data.subtype)} />}
    {img.data.image_file && <meta data-pagefind-meta="image[content]" content={`/assets/thumbs/${img.data.image_file.replace(/\.[^.]+$/, ".webp")}`} />}
    {img.data.image_file && (
      <figure data-pagefind-ignore>
        <a href={`/assets/${file}`} class="full-res" target="_blank" rel="noopener" title="Open full resolution">
          <img src={displaySrc} alt={img.data.title} decoding="async" />
        </a>
        <figcaption>
          <a href={`/assets/${file}`} target="_blank" rel="noopener">Open full resolution</a>
          {originalMB > 0 && <span> · {originalSize}</span>}
        </figcaption>
      </figure>
    )}

    <div class="image-details">
      {img.data.subtype && <span class="subtype" data-pagefind-ignore>{img.data.subtype}</span>}
      <h1>{img.data.title}</h1>
      {img.data.caption && <p class="caption">{img.data.caption}</p>}

      <div class="tags" data-pagefind-ignore>
        <FacetChips facet="place" values={img.data.place} />
        <FacetChips facet="era" values={img.data.era} />
        <FacetChips facet="culture" values={img.data.culture} />
        <FacetChips facet="religion" values={img.data.religion} />
        <FacetChips facet="politics" values={img.data.politics} />
      </div>

      {img.data.tags.length > 0 && (
        <aside class="block" data-pagefind-ignore>
          <h3>Themes</h3>
          <div class="tags">
            <FacetChips facet="tags" values={img.data.tags} />
          </div>
        </aside>
      )}

      {img.data.related_texts.length > 0 && (
        <aside class="block" data-pagefind-ignore>
          <h3>Related Texts</h3>
          <ul>
            {img.data.related_texts.map((t) => {
              const name = displayName(t);
              const slug = name.replace(/ /g, "-").toLowerCase();
              return (
                <li><a href={`/texts/${slug}`}>{name}</a></li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .image-page figure {
    margin: 0 -1.5rem;
    text-align: center;
    background: #2a2318;
    padding: 1rem;
  }
  .image-page figure .full-res {
    display: inline-block;
    border-bottom: none;
    cursor: zoom-in;
  }
  .image-page figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: #b8a888;
  }
  .image-page figure figcaption a {
    color: #e3cfa4;
    font-family: "Cinzel", serif;
    letter-spacing: 0.05em;
  }
  .image-page figure figcaption a:hover { border-bottom-color: #e3cfa4; }
  .image-page figure img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }
  .image-details {
    margin-top: 2rem;
  }
  .subtype {
    font-family: "Cinzel", serif;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.3rem;
  }
  .caption {
    color: var(--text-muted);
    font-style: italic;
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }
  .block {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .block ul {
    list-style: none;
    padding: 0;
  }
  .block li { padding: 0.3rem 0; }
</style>
