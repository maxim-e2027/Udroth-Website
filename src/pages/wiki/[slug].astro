---
/**
 * Universal resolver for body wikilinks.
 * Looks up the slug across all content collections and renders a redirect page.
 * Generates one static page per known target.
 */
import { getCollection } from "astro:content";
import { slugify } from "../../lib/wikilinks";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const texts = await getCollection("texts");
  const images = await getCollection("images");
  const authors = await getCollection("authors");

  const paths: { params: { slug: string }; props: { target: string } }[] = [];
  const seen = new Set<string>();

  const add = (slug: string, target: string) => {
    if (seen.has(slug)) return;
    seen.add(slug);
    paths.push({ params: { slug }, props: { target } });
  };

  for (const a of articles) {
    if (!a.data.publish) continue;
    const slug = slugify(a.data.title);
    add(slug, `/encyclopedia/${a.data.category}/${slug}`);
  }
  for (const t of texts) {
    if (!t.data.publish) continue;
    add(slugify(t.id), `/texts/${t.id}`);
    add(slugify(t.data.title), `/texts/${t.id}`);
  }
  for (const i of images) {
    if (!i.data.publish) continue;
    add(slugify(i.id), `/gallery/${i.id}`);
    add(slugify(i.data.title), `/gallery/${i.id}`);
  }
  for (const au of authors) {
    if (!au.data.publish) continue;
    add(slugify(au.data.title), `/authors#${slugify(au.data.title)}`);
  }
  return paths;
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>…</p>
    <script set:html={`window.location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
