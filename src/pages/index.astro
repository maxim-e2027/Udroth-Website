---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { displayName } from "../lib/wikilinks";

const allTexts = (await getCollection("texts")).filter((t) => t.data.publish);
const allImages = (await getCollection("images")).filter((i) => i.data.publish);
---

<Base title="Archives">
  <section class="hero">
    <h1>Archives of Udroth</h1>
    <p class="subtitle">Fragments from a world beneath the stone</p>
  </section>

  <section>
    <h2>Texts</h2>
    <div class="card-grid">
      {allTexts.map((text) => (
        <a href={`/texts/${text.id}`} class="card">
          <h3>{text.data.title}</h3>
          <div class="meta">
            {text.data.subtype && <span>{text.data.subtype}</span>}
            {text.data.date_in_world && <span> · {text.data.date_in_world}</span>}
          </div>
          {text.data.excerpt && <p class="excerpt">{text.data.excerpt}</p>}
          <div class="tags">
            {text.data.era.map((e) => <span class="tag">{displayName(e)}</span>)}
            {text.data.culture.map((c) => <span class="tag">{displayName(c)}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Gallery</h2>
    <div class="card-grid">
      {allImages.map((img) => (
        <a href={`/gallery/${img.id}`} class="card">
          {img.data.image_file && (
            <img
              src={`/assets/${img.data.image_file}`}
              alt={img.data.title}
              loading="lazy"
              style="width:100%; height:200px; object-fit:cover; margin-bottom:1rem;"
            />
          )}
          <h3>{img.data.title}</h3>
          {img.data.caption && <p class="excerpt">{img.data.caption}</p>}
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  .subtitle {
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }
</style>
